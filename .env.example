# Copie para .env.local e preencha. Nenhuma variável é obrigatória para o site subir;
# sem as de EmailJS e reCAPTCHA, o formulário de contato responde com erro.

# EmailJS (usadas só no servidor, em src/app/api/contact/route.ts)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# reCAPTCHA v3: a site key vai para o navegador, a secret fica no servidor
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Dados exibidos na seção de contato
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_GITHUB=
NEXT_PUBLIC_LINKEDIN=

# Verificação de propriedade nos buscadores (meta tags do layout)
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
